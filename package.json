{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@kirchdev/laravel-notification-delivery",
  "version": "0.1.1",
  "private": true,
  "description": "Dev tooling for kirchdev/laravel-notification-delivery (Composer package).",
  "homepage": "https://github.com/kirchDev/laravel-notification-delivery",
  "bugs": {
    "url": "https://github.com/kirchDev/laravel-notification-delivery/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev> (https://kirch.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirchDev/laravel-notification-delivery.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "pnpm lint && pnpm format",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "skills:update": "pnpm dlx skills@latest update -p -y",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "taze": "^21.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.2.1"
}
